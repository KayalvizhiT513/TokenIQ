// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id   String @id @default(cuid())
  name String
  slug String @unique

  users        User[]
  repositories Repository[]
  integrations Integration[]
  modelConfigs ModelConfig[]
  usageEvents  UsageEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name         String
  email        String @unique
  passwordHash String
  role         String @default("viewer") // 'admin' | 'editor' | 'viewer'

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Repository {
  id           String @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  owner             String
  name              String
  encryptedPat      String  // AES-256-GCM encrypted
  modelConfigId     String?
  modelConfig       ModelConfig? @relation(fields: [modelConfigId], references: [id], onDelete: SetNull)
  lastSyncedAt      DateTime?

  pullRequests PullRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, owner, name])
}

model ModelConfig {
  id                 String @id @default(cuid())
  orgId              String
  organization       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  provider           String
  model              String
  inputCostPerMillion Float
  outputCostPerMillion Float
  cachedCostPerMillion Float @default(0)
  isDefault          Boolean @default(false)
  isActive           Boolean @default(true)
  repositories       Repository[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([orgId, provider, model])
  @@index([orgId, isActive])
}

model PullRequest {
  id           String @id @default(cuid())
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  number        Int
  title         String
  author        String
  filesChanged  Int
  linesAdded    Int
  linesDeleted  Int
  mergedAt      DateTime?
  openedAt      DateTime
  minutesToMerge Int?

  usageRecord UsageRecord?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([repositoryId, number])
}

model Integration {
  id           String @id @default(cuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  provider         String // 'openai' | 'anthropic' | 'copilot'
  encryptedApiKey  String // AES-256-GCM encrypted

  lastVerifiedAt   DateTime?
  lastSyncedAt     DateTime?
  lastSyncError    String?
  isActive         Boolean @default(true)
  usageEvents      UsageEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, provider])
}

/// A normalized, request-level event received from a provider collector or SDK.
/// Unlike UsageRecord (a PR estimate), these rows are actual platform telemetry.
model UsageEvent {
  id             String   @id @default(cuid())
  orgId          String
  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  integrationId  String?
  integration    Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  provider       String
  model          String
  modelVersion   String?
  requestId      String?
  traceId        String?
  spanId         String?
  sourceEventId  String?
  startedAt      DateTime
  endedAt        DateTime?
  latencyMs      Int?
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  cachedTokens   Int      @default(0)
  totalTokens    Int      @default(0)
  costUsd        Float?
  statusCode     Int?
  metadata       String?
  createdAt      DateTime @default(now())

  @@unique([orgId, sourceEventId])
  @@index([orgId, startedAt])
  @@index([orgId, provider, model])
  @@index([orgId, traceId])
}

model UsageRecord {
  id            String @id @default(cuid())
  pullRequestId String @unique
  pullRequest   PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  provider           String @default("openai")   // 'openai' | 'anthropic' | 'github'
  model              String   // 'gpt-4o' | 'claude-3-5-sonnet' | 'copilot-gpt-4'
  inputTokens        Int
  outputTokens       Int
  cachedInputTokens  Int
  costUsd            Float    // Estimated cost from PR metadata

  // Actual cost/usage from OpenAI API (optional, for verification)
  actualCostUsd      Float?
  actualInputTokens  Int?
  actualOutputTokens Int?

  // Insights
  insights           String?  // AI-generated summary of model effectiveness
  isSynthetic        Boolean  @default(false) // Seeded demo estimate, not live repository data

  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
